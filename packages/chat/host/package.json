{
  "name": "@dsh-chat/host",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "dsh-chat host 插件：本地数据库、relay 客户端、同源路由与事件发布",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "@dsh-chat/audit": "workspace:^",
    "@dsh-chat/client": "workspace:^",
    "@dsh-chat/contract": "workspace:^",
    "@dsh-chat/messaging": "workspace:^",
    "@dsh-chat/notification": "workspace:^",
    "@dsh-chat/organization": "workspace:^",
    "@dsh-chat/workitem": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.2-alpha.1",
    "@deepseek-ai/dsh-invariants": "0.1.2-alpha.1"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
